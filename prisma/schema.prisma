generator client {
  provider = "prisma-client"
  output = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum LeadStatus{
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}
enum QuotationStatus{
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}
enum InstallationJobStatus{
  PENDING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}


model Customers {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  contact   String
  address   String
  createdAt DateTime @default(now())

  leads     Leads[]
}

model Leads {
  id           Int      @id @default(autoincrement())
  customerId   Int
  status       LeadStatus
  estimatedBill Int
  createdAt    DateTime @default(now())

  customer     Customers    @relation(fields: [customerId], references: [id])
  siteSurvey   SiteSurveys?
  quotation    Quotations?
}

model SiteSurveys {
  id        Int      @id @default(autoincrement())
  leadId    Int      @unique
  area      String
  createdAt DateTime @default(now())

  lead      Leads    @relation(fields: [leadId], references: [id])
}

model Equipment {
  id        Int      @id @default(autoincrement())
  name      String
  type      String
  quantity  Int
  unitPrice Int
  createdAt DateTime @default(now())
}

model Quotations {
  id         Int      @id @default(autoincrement())
  leadId     Int      @unique
  totalPrice Int
  status     QuotationStatus
  createdAt  DateTime @default(now())

  lead       Leads    @relation(fields: [leadId], references: [id])
  job        InstallationJobs?
}

model InstallationJobs {
  id            Int      @id @default(autoincrement())
  quotationId   Int      @unique
  scheduledDate String
  status        InstallationJobStatus
  createdAt     DateTime @default(now())

  quotation     Quotations @relation(fields: [quotationId], references: [id])
}